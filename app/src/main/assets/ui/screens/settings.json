{
  "sources": ["settings", "telemetry"],
  "root": {
    "type": "column", "fill": true, "padding": [24, 16], "gap": 16, "scroll": true,
    "children": [
      {"type": "row", "gap": 12, "children": [
        {"type": "button", "variant": "icon", "icon": "back", "onClick": {"do": "back"}},
        {"type": "text", "style": "title", "text": "{{t.settings}}"}
      ]},
      {"type": "row", "arrange": "between", "fillWidth": true, "padding": [16, 14], "bg": "glass@8", "radius": 20,
       "children": [
         {"type": "text", "style": "label", "text": "{{t.noai}}"},
         {"type": "switch", "value": "{{settings.noAi}}", "onChange": {"do": "call", "name": "setNoAi", "args": {"on": "{{value}}"}}}
       ]}
    ]
  }
}
