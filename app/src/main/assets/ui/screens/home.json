{
  "sources": ["instances", "accounts", "settings"],
  "root": {
    "type": "row", "fill": true, "padding": [16, 12],
    "children": [
      {"type": "column", "width": 64, "fillHeight": true, "arrange": "between", "align": "center", "padding": [0, 8],
       "bg": "glass@6", "radius": 24, "border": {"width": 1, "color": "glass@8"},
       "children": [
         {"type": "column", "gap": 12, "align": "center", "children": [
           {"type": "button", "variant": "icon", "icon": "bolt", "bg": "accent"},
           {"type": "button", "variant": "icon", "icon": "home", "onClick": {"do": "reload"}},
           {"type": "button", "variant": "icon", "icon": "grid", "onClick": {"do": "nav", "to": "instances"}},
           {"type": "button", "variant": "icon", "icon": "mods", "onClick": {"do": "nav", "to": "instances"}}
         ]},
         {"type": "button", "variant": "icon", "icon": "settings", "onClick": {"do": "nav", "to": "settings"}}
       ]},
      {"type": "spacer", "width": 16},
      {"type": "column", "weight": 1, "fillHeight": true, "arrange": "between",
       "children": [
         {"type": "row", "gap": 10, "children": [
           {"type": "button", "variant": "pill", "icon": "versions", "text": "{{current.version}}"},
           {"type": "button", "variant": "pill", "icon": "person", "text": "{{me.name}}"}
         ]},
         {"type": "column", "gap": 6, "children": [
           {"type": "text", "style": "small", "color": "muted", "text": "{{t.instances}}"},
           {"type": "text", "style": "small", "color": "danger", "text": "{{errors}}", "visible": "{{errors}}"},
           {"type": "text", "style": "hero", "text": "{{current.name}}", "maxLines": 2},
           {"type": "row", "gap": 12, "children": [
             {"type": "button", "variant": "primary", "icon": "play", "text": "{{t.play}}",
              "onClick": {"do": "call", "name": "launch", "ok": "{{t.started}}", "refresh": false}},
             {"type": "button", "variant": "ghost", "icon": "tune", "text": "{{t.configure}}",
              "onClick": {"do": "nav", "to": "settings"}}
           ]}
         ]},
         {"type": "row", "gap": 10, "children": [
           {"type": "button", "variant": "pill", "icon": "mods", "text": "{{t.mods}}", "onClick": {"do": "nav", "to": "instances"}},
           {"type": "button", "variant": "pill", "icon": "servers", "text": "{{t.servers}}"},
           {"type": "button", "variant": "pill", "icon": "cloud-download", "text": "{{t.updates}}"}
         ]}
       ]}
    ]
  }
}
