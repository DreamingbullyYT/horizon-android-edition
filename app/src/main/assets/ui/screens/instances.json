{
  "sources": ["instances", "settings"],
  "root": {
    "type": "column", "fill": true, "padding": [24, 16], "gap": 16,
    "children": [
      {"type": "row", "gap": 12, "children": [
        {"type": "button", "variant": "icon", "icon": "back", "onClick": {"do": "back"}},
        {"type": "text", "style": "title", "text": "{{t.instances}}"}
      ]},
      {"type": "list", "direction": "grid", "columns": 2, "gap": 12, "scroll": true, "weight": 1,
       "items": "{{instances}}",
       "empty": {"type": "text", "color": "muted", "text": "{{t.no_instances}}"},
       "template": {"type": "column", "gap": 8, "fillWidth": true, "padding": [16, 14], "bg": "glass@8", "radius": 20,
                    "border": {"width": 1, "color": "glass@10"},
                    "onClick": [{"do": "call", "name": "selectInstance", "args": {"id": "{{item.id}}"}}, {"do": "back"}],
                    "children": [
                      {"type": "text", "style": "label", "text": "{{item.name}}", "maxLines": 1},
                      {"type": "text", "style": "small", "color": "muted", "text": "{{item.version}}"}
                    ]}}
    ]
  }
}
